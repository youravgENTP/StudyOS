# Local/server/administrative only. Never use these from src/ or prefix them VITE_.
# `neon link` manages the real values in the gitignored .env.local file.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://user:password@host/database?sslmode=require
NEON_BRANCH=production
NEON_AUTH_JWKS_URL=https://example.neon.tech/.well-known/jwks.json

# Browser-safe service endpoints pulled by `neon link`.
# vite.config.ts explicitly maps only these endpoints into the client bundle.
NEON_AUTH_BASE_URL=https://example.neonauth.region.aws.neon.tech/database/auth
NEON_DATA_API_URL=https://example.apirest.region.aws.neon.tech/database/rest/v1

# Optional Vercel/host aliases. If present, these take precedence.
VITE_NEON_AUTH_URL=https://example.neonauth.region.aws.neon.tech/database/auth
VITE_NEON_DATA_API_URL=https://example.apirest.region.aws.neon.tech/database/rest/v1
